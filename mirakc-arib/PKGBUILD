pkgname=mirakc-arib
pkgver=0.24.5
pkgrel=1
arch=('any')
makedepends=('cmake' 'dos2unix' 'ninja' 'pkg-config')
source=(git+https://github.com/mirakc/mirakc-arib?#tag=$pkgver)
sha256sums=('SKIP')
build() {
    cd "$pkgname"

    git submodule init && git submodule update --depth=1
    cmake -S . -B build -G Ninja -D CMAKE_BUILD_TYPE=Release
    ninja -C build vendor
    ninja -C build
}

package() {
    cd "$pkgname"

    install -Dm0755 build/bin/mirakc-arib -t "$pkgdir/usr/bin/"
}

